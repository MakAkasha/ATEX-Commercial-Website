<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <%- include('partials/head', { meta }) %>
    <%- include('partials/structured-data') %>
  </head>
  <body>
    <%- include('partials/site-header') %>
    <main class="subpage" id="main-content" tabindex="-1" aria-label="المحتوى الرئيسي">
      <div class="container">
        <nav class="breadcrumbNav" aria-label="مسار التنقل">
          <ol class="breadcrumbNav__list">
            <li class="breadcrumbNav__item"><a href="/">الرئيسية</a></li>
            <li class="breadcrumbNav__item breadcrumbNav__item--current" aria-current="page">المدونة</li>
          </ol>
        </nav>

        <header class="subpage__head">
          <h1 class="subpage__title">المدونة</h1>
          <p class="subpage__desc">مقالات عن أنظمة المباني الذكية في السعودية: التكلفة، التكامل، والتشغيل.</p>
        </header>

        <section class="blogIntroPanel" aria-label="ملخص المدونة">
          <div class="blogIntroPanel__item">
            <strong>من مشاريع نفّذناها</strong>
            <span>نكتب عن الأنظمة التي نركّبها: KNX، الإضاءة، والتكامل مع أنظمة المبنى.</span>
          </div>
          <div class="blogIntroPanel__item">
            <strong>قبل التعاقد وبعد التسليم</strong>
            <span>ما تحتاج معرفته عن التكلفة والصيانة والتشغيل اليومي.</span>
          </div>
          <div class="blogIntroPanel__item">
            <strong>للمالك والاستشاري</strong>
            <span>نكتب لملاك الفلل والمباني وللمكاتب الاستشارية التي تكتب المواصفات.</span>
          </div>
        </section>

        <div class="blogGrid">
          <% posts.forEach(function(p){ %>
            <article class="blogCard" data-tilt>
              <a href="/blog/<%= p.slug %>" aria-label="<%= p.title %>">
                <div class="blogCard__media">
                  <%# Covers are admin uploads, so derivatives exist only for files
                      uploaded after the pipeline landed (or covered by a
                      generate-image-derivatives run on the uploads dir); picture()
                      degrades to a plain <img> for the rest. No width/height: the
                      ratio of an arbitrary upload is unknown here, and
                      .blogCard__media pins a fixed 158px height with the image at
                      `width/height: 100%; object-fit: cover`, so the box cannot
                      shift no matter what loads into it. %>
                  <% if (p.cover_image) { %>
                    <%# The <a> carries aria-label, which replaces the whole
                        subtree for assistive tech — so this alt is for image
                        search, and stays empty when the author wrote none. %>
                    <%- picture(p.cover_image, { alt: p.cover_image_alt || '', sizes: imageSizes.blogCardCover }) %>
                  <% } else { %>
                    <div class="blogCard__mediaFallback">ATEX</div>
                  <% } %>
                </div>
                <div class="blogCard__body">
                  <div class="blogCard__meta">
                    <% if (p.tags && p.tags.length) { %>
                      <span class="blogCard__pill"><%= p.tags[0] %></span>
                    <% } else { %>
                      <span class="blogCard__pill">Insight</span>
                    <% } %>
                    <div class="blogCard__metaRight">
                      <% if (p.readingTime) { %>
                        <span class="blogReadingTime"><%- icon('clock') %> <%= p.readingTime %> د</span>
                      <% } %>
                      <% if (p.formattedDate) { %><time dir="ltr" datetime="<%= p.isoPublished || '' %>"><%= p.formattedDate %></time><% } %>
                    </div>
                  </div>
                  <h3 class="blogCard__title"><%= p.title %></h3>
                  <p class="blogCard__desc"><%= p.excerpt %></p>
                  <% if (p.tags && p.tags.length > 1) { %>
                    <div class="blogTagChips">
                      <% p.tags.slice(0, 4).forEach(function(tag){ %>
                        <span class="blogTagChip"><%= tag %></span>
                      <% }) %>
                    </div>
                  <% } %>
                  <div class="blogCard__footer"><span class="btn btn--ghost btn--small">اقرأ المقال</span></div>
                </div>
              </a>
            </article>
          <% }) %>
        </div>

        <% if (!posts || posts.length === 0) { %>
          <div class="blogEmpty">
            <p>لا توجد مقالات منشورة حالياً. تابعونا قريباً.</p>
          </div>
        <% } %>
      </div>

      <%- include('partials/final-cta', {
        heading: 'هل تريد تطبيق ما قرأته في مشروعك؟',
        subheading: 'أرسل لنا مخططك ونقترح الأنظمة المناسبة له.',
        mainAction: '<a class="btn btn--primary" href="/contact-us">تواصل معنا</a>',
        cardHeading: 'تحدّث مع مهندس من فريقنا عن مشروعك',
        cardDesc: 'نراجع مخططك ونقترح الأنظمة المناسبة. نرد عليك في نفس يوم العمل.'
      }) %>
    </main>
    <%- include('partials/site-footer') %>
  </body>
</html>
