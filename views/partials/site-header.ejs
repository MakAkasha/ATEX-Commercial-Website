<a class="skip-link" href="#main-content">انتقل إلى المحتوى الرئيسي</a>
<div class="scrollProgress" id="scrollProgress" aria-hidden="true"></div>
<!-- Top bar -->
<% const __homeContent = (typeof content !== 'undefined') ? content : null; %>
<%# topbar.phone, topbar.ctaText and topbar.ctaHref are admin-editable and were
    hardcoded here, so editing them saved and changed nothing. The sales number
    has no schema field and stays fixed. %>
<% const __topbarPhone = (__homeContent?.topbar?.phone || '+966580102121'); %>
<% const __topbarSales = '0509330008'; %>
<% const __topbarWhatsapp = 'https://wa.me/' + String(__topbarPhone).replace(/\D/g, ''); %>
<% const __portalText = (__homeContent?.topbar?.ctaText || 'بوابة العملاء'); %>
<% const __portalHref = (__homeContent?.topbar?.ctaHref || 'https://portal.atex-ksa.com'); %>
<div class="topbar">
  <div class="container topbar__inner">
    <div class="topbar__item">
      <span>
        <%= (__homeContent?.topbar?.supportText || 'خدمة العملاء:') %>
        <a href="<%= __topbarWhatsapp %>" target="_blank" rel="noopener noreferrer" dir="ltr"><strong><%= __topbarPhone %></strong></a>
        <span class="topbar__sales">
          <span class="topbar__sep" aria-hidden="true">·</span>
          المبيعات:
          <a href="tel:<%= __topbarSales %>" dir="ltr"><strong><%= __topbarSales %></strong></a>
        </span>
      </span>
    </div>
    <div class="topbar__item">
      <span class="topbar__tagline"><%= (__homeContent?.topbar?.tagline || 'حلول إنترنت الأشياء') %></span>
      <a class="topbar__textLink" href="<%= __portalHref %>" target="_blank" rel="noopener noreferrer" aria-label="<%= __portalText %> — الشريط العلوي، يفتح في تبويب جديد">
        <span><%= __portalText %></span>
        <span class="topbar__extIcon" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</div>

<!-- Navbar -->
<header class="header" id="home">
  <div class="container header__inner">
    <!-- Brand + nav grouped on RIGHT -->
    <a class="brand" href="/" aria-label="الانتقال إلى الرئيسية">
      <img class="brand__logoImg brand__logoImg--light" src="/assets/ATEX-logo.svg" alt="ATEX" width="158" height="41" />
      <img class="brand__logoImg brand__logoImg--dark" src="/assets/ATEX-Dark-logo.svg" alt="" aria-hidden="true" width="158" height="41" />
    </a>

    <nav class="nav" aria-label="التنقّل الرئيسي">
      <div class="nav__backdrop" data-nav-backdrop aria-hidden="true"></div>
      <button
        class="nav__toggle"
        type="button"
        aria-label="فتح القائمة"
        aria-expanded="false"
        aria-controls="navMenu">
        <span class="nav__toggleLines" aria-hidden="true"></span>
      </button>

      <div class="nav__menu" id="navMenu">
        <a class="nav__link" data-route href="/">الرئيسية</a>
        <a class="nav__link" data-route href="/solutions">الأنظمة والحلول</a>
        <a class="nav__link" data-route href="/blog">المدونة</a>
        <a class="nav__link" data-route href="/contact-us">تواصل معنا</a>
        <a class="btn btn--primary btn--small" href="<%= __portalHref %>" target="_blank" rel="noopener noreferrer" dir="rtl" aria-label="<%= __portalText %> — القائمة الرئيسية، يفتح في تبويب جديد">
          <span class="nav__extIcon" aria-hidden="true">↗</span>
          <span><%= __portalText %></span>
        </a>
      </div>
    </nav>
  </div>
</header>
