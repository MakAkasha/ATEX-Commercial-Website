<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#ff9933" />

<!-- Primary Meta Tags -->
<title><%= meta?.title || "ATEX" %></title>
<meta name="title" content="<%= meta?.title || "ATEX" %>" />
<meta name="description" content="<%= meta?.description || "" %>" />
<meta name="keywords" content="<%= meta?.keywords || 'إنترنت الأشياء, IoT, السعودية, تقنية, حلول ذكية, أتمتة, تتبع الأصول, إدارة الأساطيل, المراقبة البيئية, العدادات والطاقة, المنازل الذكية, Smart Homes, الفنادق الذكية, Smart Hotels, المكاتب الذكية, Smart Offices, المباني الذكية, Smart Buildings, إضاءة الواجهات الخارجية للمباني, Building Exterior Lighting, Facade Lighting, نظام المكنسة المركزية, Central Vacuum System, حلول شحن السيارات الكهربائية, Electric Vehicle Charging, EV Charging, الانظمة الامنية التقنية, Security Systems, Technical Security Systems, انظمة تقنية المعلومات, Information Technology Systems, IT Systems, ICT Systems, Smart Building Systems' %>" />
<% if (meta?.author) { %><meta name="author" content="<%= meta.author %>" /><% } %>

<!-- Robots Meta Tags -->
<meta name="robots" content="<%= meta?.robots || 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1' %>" />
<meta name="googlebot" content="<%= (meta?.robots || '').includes('noindex') ? 'noindex, nofollow' : 'index, follow' %>" />
<meta name="bingbot" content="<%= (meta?.robots || '').includes('noindex') ? 'noindex, nofollow' : 'index, follow' %>" />

<!-- Open Graph / Facebook -->
<%
  const __ogImage = meta?.ogImage || '/assets/solutions/smart-building.webp';
  const __ogImageType = __ogImage.match(/\.(png|gif|webp)$/i) ? 'image/' + __ogImage.match(/\.(png|gif|webp)$/i)[1].toLowerCase() : 'image/jpeg';
%>
<meta property="og:type" content="<%= meta?.ogType || 'website' %>" />
<meta property="og:url" content="<%= meta?.canonical || '' %>" />
<meta property="og:title" content="<%= meta?.ogTitle || meta?.title || 'أتكس' %>" />
<meta property="og:description" content="<%= meta?.ogDescription || meta?.description || '' %>" />
<meta property="og:image" content="<%= __ogImage %>" />
<meta property="og:image:secure_url" content="<%= __ogImage %>" />
<meta property="og:image:type" content="<%= __ogImageType %>" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="<%= meta?.ogImageAlt || 'أتكس - حلول إنترنت الأشياء' %>" />
<meta property="og:site_name" content="ATEX" />
<meta property="og:locale" content="ar_SA" />
<% if (meta?.ogType === 'article') { %>
<meta property="article:published_time" content="<%= meta.articlePublishedTime || '' %>" />
<meta property="article:modified_time" content="<%= meta.articleModifiedTime || '' %>" />
<% if (meta?.articleAuthor) { %><meta property="article:author" content="<%= meta.articleAuthor %>" /><% } %>
<% if (meta?.articleSection) { %><meta property="article:section" content="<%= meta.articleSection %>" /><% } %>
<% if (meta?.articleTags && meta.articleTags.length) { meta.articleTags.forEach(function(tag){ %><meta property="article:tag" content="<%= tag %>" /><% }); } %>
<% } %>

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content="<%= meta?.canonical || '' %>" />
<meta name="twitter:title" content="<%= meta?.ogTitle || meta?.title || 'أتكس' %>" />
<meta name="twitter:description" content="<%= meta?.ogDescription || meta?.description || '' %>" />
<meta name="twitter:image" content="<%= __ogImage %>" />
<meta name="twitter:image:alt" content="<%= meta?.ogImageAlt || 'أتكس - حلول إنترنت الأشياء' %>" />

<!-- Canonical URL -->
<% if (meta?.canonical) { %><link rel="canonical" href="<%= meta.canonical %>" /><% } %>

<!-- RSS feed autodiscovery -->
<link rel="alternate" type="application/rss+xml" title="مدونة أتكس | ATEX Blog" href="/blog/rss.xml" />

<!-- Favicon -->
<link rel="icon" href="/assets/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/assets/favicon-512.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />

<!-- Preconnect and Preload Critical Resources -->
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />

<!-- Preload the one font file first paint always needs: Cairo's arabic subset.
     Cairo is a variable font, so this single file backs body text (400) and
     every bold/extrabold rule (700/800). @font-face lives in styles.css. -->
<link rel="preload" href="/assets/fonts/cairo/cairo-v31-var-arabic.woff2" as="font" type="font/woff2" crossorigin />

<!-- Stylesheets -->
<link rel="stylesheet" href="/assets/css/styles.css?v=<%= typeof assetVer !== 'undefined' ? assetVer : '1' %>" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" media="print" onload="this.media='all'" />
<noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" /></noscript>
<% if (meta?.preloadImage) { %><link rel="preload" as="image" href="<%= meta.preloadImage %>" fetchpriority="high" /><% } %>

<% const __analytics = (typeof analytics !== 'undefined') ? analytics : null; %>

<%# Consent-by-default: all tags fire on every load when analytics is enabled (governed by the privacy policy). %>
<% if (__analytics && __analytics.enabled) { %>
  <% if (__analytics.gtmContainerId) { %>
    <!-- Google Tag Manager -->
    <script>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','<%= __analytics.gtmContainerId %>');
